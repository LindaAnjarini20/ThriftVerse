APP_NAME=ThriftVerse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://thriftverse.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Laragon: MySQL bawaan, user root tanpa password. Buat database "thriftverse" (HeidiSQL / Laragon > Database).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thriftverse
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Email verifikasi ditulis ke storage/logs/laravel.log (ganti ke SMTP / Mailtrap bila perlu)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@thriftverse.test"
MAIL_FROM_NAME="${APP_NAME}"

# true = pengguna wajib verifikasi email sebelum transaksi (FR-001)
THRIFTVERSE_REQUIRE_VERIFIED=false

# Midtrans Snap (jangan commit nilai secret key)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_ENV=sandbox
